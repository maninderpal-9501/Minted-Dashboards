# ---------- Ekyam Dev MCP server ----------
# Local: the dev MCP endpoint. Azure: the backend's internal URL (e.g. .../mcp-internal) once it exists.
EKYAM_MCP_URL=https://mcp-dev.ekyam.ai/mcp
# oauth | api_key | entra | none
MCP_AUTH_MODE=oauth
# oauth mode: client made once with the backend's /admin/clients (on the SAME host as EKYAM_MCP_URL)
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_OAUTH_SCOPE=mcp.read
# Leave empty: found automatically from the MCP server's /.well-known metadata
MCP_OAUTH_TOKEN_URL=
# api_key mode: a fixed bearer token the MCP server accepts
EKYAM_MCP_TOKEN=
# entra mode (Azure): the backend's app registration scope; the token comes from Managed Identity / az login
MCP_ENTRA_SCOPE=
# Seconds to wait for one tool call (billing / reorder can be slow on a cold cache)
MCP_TIMEOUT_SECONDS=180

# ---------- Pages ----------
MINTED_PAGES_DIR=./pages
MINTED_API_PATH=/minted/api/tools
# Simple sign-in: open any page once with ?key=<value>. Empty = no sign-in (local testing only)
MINTED_DEMO_KEY=

# ---------- Warm-up ----------
WARMUP_ENABLED=true
# cron: minute hour day month weekday  (default: 7:00 Mon-Fri)
WARMUP_CRON=0 7 * * 1-5
WARMUP_TZ=Asia/Kolkata
WARMUP_ON_STARTUP=false
WARMUP_CONCURRENCY=6

# ---------- Excel ----------
# Recalculate formulas with LibreOffice when it is installed (Docker build arg WITH_LIBREOFFICE=1)
EXCEL_RECALC=true

LOG_LEVEL=INFO
